  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shipped primary action treatment.",
      "html": "<button class=\"ds-control ds-button\">New candidate</button>",
      "css": ".ds-button{font-family:var(--font-sans,'Inter Variable',Inter,sans-serif);min-height:34px;border-radius:6px;font-size:11px;font-weight:550;padding:7px 12px;line-height:1.4;border:1px solid transparent;background:var(--primary,#b9dcff);color:var(--primary-foreground,#163e68);cursor:pointer}.ds-button:hover{background:var(--primary-hover,#a5cff7)}.ds-control:focus-visible{outline:2px solid var(--accent,#275f9c);outline-offset:3px}"
    },
    {
      "name": "Outline button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Shipped outline action treatment.",
      "html": "<button class=\"ds-control ds-button\">New candidate</button>",
      "css": ".ds-button{font-family:var(--font-sans,'Inter Variable',Inter,sans-serif);min-height:34px;border-radius:6px;font-size:11px;font-weight:550;padding:7px 12px;line-height:1.4;border:1px solid var(--border,#dce5f0);background:var(--surface,#ffffff);color:var(--foreground,#203047);cursor:pointer}.ds-button:hover{background:var(--surface-hover,#f0f5fb)}.ds-control:focus-visible{outline:2px solid var(--accent,#275f9c);outline-offset:3px}"
    },
    {
      "name": "Ghost button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Shipped ghost action treatment.",
      "html": "<button class=\"ds-control ds-button\">New candidate</button>",
      "css": ".ds-button{font-family:var(--font-sans,'Inter Variable',Inter,sans-serif);min-height:34px;border-radius:6px;font-size:11px;font-weight:550;padding:7px 12px;line-height:1.4;border:1px solid transparent;background:transparent;color:var(--muted,#5f7087);cursor:pointer}.ds-button:hover{background:var(--surface-hover,#f0f5fb)}.ds-control:focus-visible{outline:2px solid var(--accent,#275f9c);outline-offset:3px}"
    },
    {
      "name": "Text input",
      "kind": "input",
      "refersTo": "input",
      "description": "Labeled record field.",
      "html": "<label class=\"ds-label\">Headline<input class=\"ds-control ds-input\" placeholder=\"Not set\" /></label>",
      "css": ".ds-label{font-family:var(--font-sans,'Inter Variable',Inter,sans-serif);font-size:11px;color:var(--muted,#5f7087)}.ds-input{font-family:var(--font-sans,'Inter Variable',Inter,sans-serif);display:block;margin-top:6px;background:var(--surface,#ffffff);color:var(--foreground,#203047);border:1px solid var(--border,#dce5f0);border-radius:6px;padding:9px 11px;font-size:12px;line-height:1.5;caret-color:var(--accent,#275f9c)}.ds-input::placeholder{color:var(--muted,#5f7087)}.ds-control:focus-visible{outline:2px solid var(--accent,#275f9c);outline-offset:3px}"
    },
    {
      "name": "Navigation item",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Active desktop destination.",
      "html": "<button class=\"ds-control ds-nav\" aria-current=\"page\">Candidates</button>",
      "css": ".ds-nav{font-family:var(--font-sans,'Inter Variable',Inter,sans-serif);min-height:41px;padding:10px 12px;border:0;border-radius:7px;background:var(--surface,#ffffff);color:var(--accent,#275f9c);font-size:12px;font-weight:650;text-align:left;cursor:pointer}.ds-nav:hover{background:var(--surface-hover,#f0f5fb)}.ds-control:focus-visible{outline:2px solid var(--accent,#275f9c);outline-offset:3px}"
    },

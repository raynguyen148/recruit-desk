      "css": ".ds-badge{font-family:var(--font-sans,'Inter Variable',Inter,sans-serif);display:inline-flex;padding:3px 7px;border-radius:5px;font-size:9px;line-height:1.5;font-weight:500;color:var(--green,#38694e);background:var(--green-bg,#e9f3e9)}"

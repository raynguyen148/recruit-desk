      "description": "Bordered record container.",
      "html": "<div class=\"ds-surface\"><div class=\"ds-row\">Candidate records</div></div>",
      "css": ".ds-surface{font-family:var(--font-sans,'Inter Variable',Inter,sans-serif);background:var(--surface,#ffffff);color:var(--foreground,#203047);border:1px solid var(--border,#dce5f0);border-radius:8px;overflow:hidden}.ds-row{padding:12px 13px;font-size:11px}.ds-row:hover{background:var(--surface-hover,#f0f5fb)}"
    }
  ],
  "narrative": {
    "northStar": "The Professional Reference Index",
    "overview": "A professional reference index: pale blue primary actions, cool blue navigation and editable records on quiet surfaces. Typography and alignment establish hierarchy; color identifies actions and meaningful record states.\n\nThe system supports dense everyday recruiting work. Light and dark themes preserve the same relationships; fonts and icons are bundled locally.",
    "keyCharacteristics": [
      "Dense aligned records with persistent identity.",
      "Tonal surfaces and restrained borders.",
      "Protected detail editing with visible save state."
    ],
    "rules": [
      {
        "name": "The Semantic Pair Rule",
        "body": "Keep status foregrounds paired with their corresponding tinted backgrounds in either theme.",
        "section": "colors"
      },
      {
        "name": "The Protected Focus Rule",
        "body": "Reserve the large shadow and dimming overlay for elevated editors and selection menus.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain local Inter and the consistent Lucide icon vocabulary.",
      "Do show focus, dirty, saving, error and empty states explicitly.",
      "Do preserve semantic labels alongside status color.",
      "Do adapt navigation and forms to narrow screens while retaining table scrolling."
    ],
    "donts": [
      "Don't introduce remote fonts, images or analytics into the visual layer.",
      "Don't replace useful records with decorative metrics or illustration.",
      "Don't use color alone to communicate a status or failure."
    ]
  }
}

{
  "name": "recruitdesk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm run preview",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "node scripts/serve.mjs",
